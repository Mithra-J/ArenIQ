# ArenIQ — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to Git.

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (for frontend/app — public)
SUPABASE_KEY=your-anon-key-here

# Supabase Service Role Key (for backend only — keep secret!)
SUPABASE_SERVICE_ROLE=your-service-role-key-here

# Backend server port (default: 5000)
PORT=5000

# Ntfy.sh topics for authority alerts (Chengalpattu pilot)
NTFY_TOPIC_LOCAL=areniq-local-chengalpattu
NTFY_TOPIC_DISTRICT=areniq-collector-chengalpattu
NTFY_TOPIC_STATE=areniq-state-environment-tn